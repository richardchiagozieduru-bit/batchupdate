# Copy this file to .env and fill in the values.
# .env must NOT be committed to version control.

# Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# BatchUpdate SQL Server
BATCHUPDATE_DB=BatchUpdate
BATCHUPDATE_SERVER=
BATCHUPDATE_DRIVER=ODBC Driver 17 for SQL Server
BATCHUPDATE_TRUSTED_CONNECTION=yes

